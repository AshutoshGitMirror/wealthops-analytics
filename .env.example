# Optional local settings.  No secrets belong in this file.
# The project runs fully offline with the deterministic rule-based NL-to-SQL
# fallback; an LLM key is not required.

# Scenario
WEALTHOPS_SEED=42
WEALTHOPS_CLIENTS=5000
WEALTHOPS_ADVISORS=30

# Optional LLM-assisted NL-to-SQL.  The generated SQL is still passed through
# the same allowlist / SELECT-only guard and executed on a read-only DuckDB
# connection.  Leave blank for the offline rules engine.
# WEALTHOPS_LLM_API_KEY=
# WEALTHOPS_LLM_BASE_URL=https://api.openai.com/v1
# WEALTHOPS_LLM_MODEL=
